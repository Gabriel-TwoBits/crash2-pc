# The Linux release's tools, kept off the host (tools/linux/build.sh, tools/linux/run.sh). Debian trixie, pinned by
# digest, in two stages:
# - test: a 64-bit system with no 32-bit library, where the AppImage must run on what it carries, with Xvfb's virtual
#   display for a window;
# - build: GCC's 32-bit support, CMake, Ninja and Python for the build, the 32-bit development files SDL3 builds its
#   X11, Wayland (with EGL's), PulseAudio and ALSA support against (whose libraries the AppImage carries), and
#   squashfs-tools for the AppImage's image.
FROM docker.io/library/debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5 AS test

RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

FROM test AS build

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl cmake ninja-build python3 pkgconf gcc-multilib g++-multilib squashfs-tools \
        libx11-dev:i386 libxext-dev:i386 libxcursor-dev:i386 libxi-dev:i386 libxfixes-dev:i386 \
        libxrandr-dev:i386 libxss-dev:i386 libxkbcommon-dev:i386 libwayland-dev:i386 wayland-protocols \
        libegl-dev:i386 libpulse-dev:i386 libasound2-dev:i386 libudev-dev:i386 \
    && rm -rf /var/lib/apt/lists/*
